# Copy to .env in the project root. Loaded automatically on startup.
# These connection fields override inherited shell values, even when blank.
# Blank values use local saved settings (Pi's blank key reuses OPENAI_API_KEY).
DOGRAH_BASE_URL=https://dograh.example.com/api/v1
DOGRAH_LOGIN_TOKEN=

# GPT-Live 1 and Pi's OpenAI connection.
OPENAI_API_KEY=

# Optional separate Pi key; leave blank to use OPENAI_API_KEY above.
# Pi defaults to gpt-5.6-sol. Existing model/provider choices are preserved.
PI_OPENAI_API_KEY=

# Optional Claude connection for Pi. Uses its own key, never the OpenAI key.
# Claude defaults to Opus 5; existing model/provider choices are preserved.
PI_ANTHROPIC_API_KEY=

# Optional local settings. Omit machine-specific paths when sharing this file.
# For TANTEI_* only, existing shell values take priority.
# Application data defaults to ~/.tantei, outside the repository.
# TANTEI_DATA_DIR=/absolute/path/to/private/data
# TANTEI_PORT=4317
# TANTEI_PYTHON=/absolute/path/to/python

# Jev test judgments (TypeSafe). Keep the actual key server-side.
TYPESAFE_API_KEY=
